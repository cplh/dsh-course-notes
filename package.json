  "license": "MIT",
  "author": "Picasso",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cplh/dsh-course-notes.git"
  },
  "homepage": "https://github.com/cplh/dsh-course-notes#readme",
  "bugs": {
    "url": "https://github.com/cplh/dsh-course-notes/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "bilibili",
    "course-notes",
    "knowledge-map",
    "markdown",
    "docx",
    "video-summary"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.1"
  },
  "os": [
